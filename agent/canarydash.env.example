# OpenCanary Dashboard Agent Configuration
# Copy this file to /etc/canarydash.env and configure

# Required: Dashboard URL (no trailing slash)
CANARYDASH_URL=http://192.168.1.100:8088

# Required: API key (must match dashboard CANARYDASH_API_KEY)
CANARYDASH_API_KEY=your-api-key-here

# Optional: Override hostname (defaults to system hostname)
#CANARYDASH_NODE=honeypot-01

# Optional: Comma-separated list of systemd unit names to check
# Default: opencanary,opencanaryd
#CANARYDASH_SERVICE_UNITS=opencanary,opencanaryd

# Optional: Comma-separated list of config file paths to search
# Default: /etc/opencanaryd/opencanary.conf,/etc/opencanary/opencanary.conf,/root/.opencanary.conf,/home/opencanary/.opencanary.conf
#CANARYDASH_CONFIG_PATHS=/etc/opencanaryd/opencanary.conf

# Optional: HTTP timeout in seconds
# Default: 10
#CANARYDASH_TIMEOUT=10
